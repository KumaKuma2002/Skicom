# ─── Secrets — NEVER commit these ───────────────────────────────
# Local config holds the LLM api_key; keep every variant out of git.
config.yaml
config.local.yaml
config.*.local.yaml
**/config.yaml
.env
.env.*
*.env

# Keys & certificates
*.key
*.pem
id_rsa

# ─── Generated reports ──────────────────────────────────────────
reports/

# ─── Python ─────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ─── macOS app build artifacts (PyInstaller "plan B") ───────────
# NOTE: *.spec is intentionally NOT ignored — mac/Skicom.spec is committed.
mac/dist/
mac/build/

# ─── Logs & temp files ──────────────────────────────────────────
*.log
__skicom_tmp_cfg.yaml
*.swp
*.swo
*~
.DS_Store
